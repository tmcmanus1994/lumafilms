# Canonical site URL (defaults to https://lumaweddingfilms.co)
NEXT_PUBLIC_SITE_URL=https://lumaweddingfilms.co

# Existing GA4 property — analytics is silently disabled when unset (safe for previews)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Lead delivery: Zapier/Make webhook or HoneyBook email-parse bridge.
# When unset, leads are logged in Vercel function logs (never silently dropped).
LEAD_WEBHOOK_URL=
